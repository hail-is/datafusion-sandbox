#!/usr/bin/env bash
# Prepares a Claude Code cloud session's VM for work on this repo; see docs/cloud-sessions.md.
# The environment's setup script runs it as root, and the SessionStart hook in
# .claude/settings.json runs it again on every cloud session start, to catch up on what the
# environment's snapshot predates, so it is idempotent and quick when there is nothing to do:
#
#   scripts/cloud-setup
#
# Run as a SessionStart hook, it also writes the session's environment to $CLAUDE_ENV_FILE. It
# reports how long each step took on stderr.
set -euo pipefail

start=$(date +%s%N)
last=$start
# Reports the time since the previous step.
step() {
    local now
    now=$(date +%s%N)
    printf 'cloud-setup: %-28s %6d ms\n' "$1" $(((now - last) / 1000000)) >&2
    last=$now
}
echo "cloud-setup: start $(date -Is)" >&2

cd "$(dirname "$0")/.."

# A cloud session can start with its branch where the environment's snapshot left it, behind the
# remote; see docs/cloud-sessions.md. So the hook fast-forwards the branch to the remote's head,
# then reruns the script from the new checkout. A branch with commits of its own is left alone.
if [ -n "${CLAUDE_ENV_FILE:-}" ] && [ -z "${CLOUD_SETUP_SYNCED:-}" ] &&
    branch=$(git symbolic-ref --short -q HEAD); then
    head=$(git rev-parse HEAD)
    if git fetch -q origin "$branch" && git -c advice.diverging=false merge -q --ff-only FETCH_HEAD; then
        step 'checkout'
        if [ "$(git rev-parse HEAD)" != "$head" ]; then
            echo "cloud-setup: fast-forwarded $branch from ${head:0:12}" \
                "to $(git rev-parse --short=12 HEAD)" >&2
            CLOUD_SETUP_SYNCED=1 exec "$0"
        fi
    else
        echo "cloud-setup: could not fast-forward $branch to the remote's head" >&2
        step 'checkout'
    fi
fi

# The version this repo's agent instructions were written against; `outline` needs a recent one.
ast_grep_version=0.51.0

export PATH="$HOME/.cargo/bin:$PATH"

# bindgen, in a dependency's build script, needs libclang.
if ! ldconfig -p | grep 'libclang[-.0-9]*\.so' >/dev/null; then
    apt-get update -qq
    apt-get install -y -qq libclang-dev
fi
step libclang

# The image ships rustc and cargo, but rust-toolchain.toml needs rustup. sh.rustup.rs is not on
# the default network allowlist, static.rust-lang.org is.
if ! command -v rustup >/dev/null; then
    # rustup-init only installs under its own name; under any other, it acts as a toolchain proxy.
    rustup_dir=$(mktemp -d)
    curl --proto '=https' --tlsv1.2 -sSf -o "$rustup_dir/rustup-init" \
        "https://static.rust-lang.org/rustup/dist/$(uname -m)-unknown-linux-gnu/rustup-init"
    chmod +x "$rustup_dir/rustup-init"
    "$rustup_dir/rustup-init" -y --profile minimal --default-toolchain none --no-modify-path
    rm -r "$rustup_dir"
fi
step rustup
# Otherwise each install below also asks the server for a newer rustup.
rustup set auto-self-update disable
step 'rustup self-update setting'
# With no arguments, installs the toolchain and components pinned in rust-toolchain.toml. And
# stable, which python/tests/test_gce.py asks for CPU feature sets; any stable will do, so an
# installed one isn't checked for updates.
rustup toolchain install
step 'pinned toolchain'
if ! rustup toolchain list | grep '^stable-' >/dev/null; then
    rustup toolchain install stable --profile minimal
fi
step 'stable toolchain'
if [ "$(ast-grep --version 2>/dev/null)" != "ast-grep $ast_grep_version" ]; then
    ast_grep_dir=$(mktemp -d)
    curl -sSfL -o "$ast_grep_dir/ast-grep.zip" \
        "https://github.com/ast-grep/ast-grep/releases/download/$ast_grep_version/app-$(uname -m)-unknown-linux-gnu.zip"
    python3 -m zipfile -e "$ast_grep_dir/ast-grep.zip" "$ast_grep_dir"
    install -m 755 "$ast_grep_dir/ast-grep" /usr/local/bin/ast-grep
    rm -r "$ast_grep_dir"
fi
step ast-grep

# Downloads the dependencies into the snapshot. The hook skips this: cargo and `uv run` fetch what a
# newer lockfile adds themselves, and on a VM fresh from the snapshot, the first read of each cached
# file is slow, so checking them all here would only hold up the session's start.
if [ -z "${CLAUDE_ENV_FILE:-}" ]; then
    cargo fetch --locked
    step 'cargo fetch'
    uv sync --locked --directory python
    step 'uv sync'
fi

if [ -n "${CLAUDE_ENV_FILE:-}" ]; then
    # RUSTFLAGS overrides `-Ctarget-cpu=native` from .cargo/config.toml, as CI does, so a build
    # cached on one VM can't fail with SIGILL on another VM's older CPU.
    cat >>"$CLAUDE_ENV_FILE" <<'EOF'
export PATH="$HOME/.cargo/bin:$PATH"
export RUSTFLAGS=""
EOF
fi
last=$start
step total
